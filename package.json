{
  "name": "verklikker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:vm": "tsx scripts/smoke-vm.ts",
    "test:capacity": "tsx scripts/load-test.ts",
    "format": "prettier --write 'packages/**/*.ts' 'apps/**/*.{ts,tsx,css,html}' 'tests/**/*.ts' 'scripts/*.{ts,mjs}' '*.json' '*.md' 'docs/*.md' compose.yaml 'examples/*.yaml'",
    "api": "tsx apps/api/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "cli": "tsx apps/cli/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "migrate": "tsx apps/api/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "commander": "^14.0.0",
    "fastify": "5.12.7",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
